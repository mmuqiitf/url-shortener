# --- HTTP server -------------------------------------------------------------
# Port the server listens on inside the container.
PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Path to the SQLite file. Mount a volume here in production.
DB_PATH=./data/shortener.db

# Public base URL used to build `short_url` in API responses.
BASE_URL=http://localhost:8080

# --- HTTP timeouts (seconds) -------------------------------------------------
READ_TIMEOUT_SEC=10
WRITE_TIMEOUT_SEC=10
IDLE_TIMEOUT_SEC=120

# --- Click tracker -----------------------------------------------------------
# Number of worker goroutines consuming click events. 0 = NumCPU().
TRACKER_WORKERS=2

# Maximum number of events flushed in a single SQL transaction.
TRACKER_BATCH_SIZE=50

# Time-based flush interval (milliseconds). A flush is triggered by
# either the batch size OR this interval, whichever fires first.
TRACKER_FLUSH_INTERVAL_MS=1000

# Capacity of the events channel. When full, new events are dropped
# rather than blocking the redirect handler.
TRACKER_BUFFER=4096
